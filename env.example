# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Comma-separated list of manual page URLs (required)
MANUAL_PAGES=https://example.com/manual1,https://example.com/manual2,https://example.com/manual3

# Optional: Maximum number of conversation turns to keep in session history
MAX_HISTORY_LENGTH=10 